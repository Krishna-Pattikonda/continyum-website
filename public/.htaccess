# Used only on Apache hosts (e.g. Hostinger). GitHub Pages and Vercel ignore this file.

ErrorDocument 404 /404.html

# Fingerprinted build assets never change — cache them for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|avif|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml image/svg+xml
</IfModule>
