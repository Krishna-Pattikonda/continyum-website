---
/* RTO Predictor: a risk needle settles on a cash-on-delivery order, then an action is recommended.
   Resting state (no animation) = the final frame. */
---

<svg class="art" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
  <!-- gauge: low / medium / high -->
  <path class="zone low" d="M40 125A70 70 0 0 1 72.9 65.6"></path>
  <path class="zone mid" d="M77.2 63.2A70 70 0 0 1 142.8 63.2"></path>
  <path class="zone high" d="M147.1 65.6A70 70 0 0 1 180 125"></path>
  <text class="m xs" x="40" y="141" text-anchor="middle">Low</text>
  <text class="m xs" x="180" y="141" text-anchor="middle">High</text>

  <line class="needle" x1="110" y1="125" x2="110" y2="68"></line>
  <circle class="hub" cx="110" cy="125" r="5"></circle>

  <g class="score">
    <text class="big" x="110" y="167" text-anchor="middle">72</text>
    <text class="risk" x="110" y="184" text-anchor="middle">High refusal risk</text>
  </g>

  <!-- the order being scored -->
  <rect class="card" x="198" y="30" width="106" height="132" rx="6"></rect>
  <text class="m xs" x="210" y="50">ORDER #1043</text>
  <text class="t" x="210" y="69">Cash on delivery</text>
  <text class="t strong" x="210" y="84">₹1,499</text>
  <line class="rule" x1="210" x2="292" y1="95" y2="95"></line>
  <text class="m s" x="210" y="110">First order</text>
  <text class="m s" x="210" y="124">Placed at 1:12 am</text>
  <text class="m s" x="210" y="138">No landmark</text>

  <!-- recommended action -->
  <g class="action">
    <rect class="pill" x="198" y="170" width="106" height="22" rx="11"></rect>
    <text class="pill-t" x="251" y="184.5" text-anchor="middle">Ask for prepayment</text>
  </g>
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
  }

  .t {
    font-size: 10px;
    fill: var(--text);
  }

  .strong {
    font-weight: 500;
  }

  .m {
    fill: var(--muted);
  }

  .s {
    font-size: 9px;
  }

  .xs {
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .zone {
    fill: none;
    stroke-width: 9;
  }

  .low {
    stroke: var(--team-tint);
  }

  .mid {
    stroke: var(--contact-tint);
  }

  .high {
    stroke: var(--products-tint);
  }

  .needle {
    stroke: var(--text);
    stroke-width: 2.5;
    stroke-linecap: round;
    transform-box: view-box;
    transform-origin: 110px 125px;
    transform: rotate(39.6deg); /* score 72 / 100 */
    animation: rto-needle 7s cubic-bezier(0.2, 0.7, 0.2, 1) infinite both;
  }

  .hub {
    fill: var(--text);
  }

  .big {
    font-family: var(--font-serif);
    font-size: 26px;
    fill: var(--text);
  }

  .risk {
    font-size: 9.5px;
    font-weight: 500;
    fill: var(--products-ink);
  }

  .score {
    animation: rto-score 7s ease infinite both;
  }

  .card {
    fill: #ffffff;
    stroke: var(--hairline);
  }

  .rule {
    stroke: var(--hairline);
  }

  .pill {
    fill: #fff6ef;
    stroke: var(--products-tint);
  }

  .pill-t {
    font-size: 9px;
    font-weight: 500;
    fill: var(--products-ink);
  }

  .action {
    animation: rto-action 7s ease infinite both;
  }

  @keyframes rto-needle {
    0% {
      transform: rotate(-90deg);
    }
    32%,
    88% {
      transform: rotate(39.6deg);
    }
    100% {
      transform: rotate(-90deg);
    }
  }

  @keyframes rto-score {
    0%,
    24% {
      opacity: 0;
    }
    34%,
    88% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  @keyframes rto-action {
    0%,
    38% {
      opacity: 0;
      transform: translateY(6px);
    }
    46%,
    88% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
</style>
