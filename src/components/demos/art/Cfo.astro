---
/* AI CFO: an order's revenue bar shrinks as each cost is subtracted, ending at true profit.
   Resting state = all costs listed, bar at true profit. */
const costs = [
  { label: 'Returns', value: '−₹180' },
  { label: 'Discounts', value: '−₹120' },
  { label: 'Shipping', value: '−₹90' },
  { label: 'Ad spend', value: '−₹240' },
];
---

<svg class="art" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
  <text class="m xs" x="24" y="22">REVENUE PER ORDER</text>
  <text class="t strong" x="296" y="22" text-anchor="end">₹1,000</text>

  <rect class="track" x="24" y="32" width="272" height="18" rx="3"></rect>
  <rect class="bar" x="24" y="32" width="272" height="18" rx="3"></rect>

  {
    costs.map((c, i) => (
      <g class={`cost c${i + 1}`}>
        <circle class="cdot" cx="28" cy={72 + i * 19} r="3" />
        <text class="t" x="38" y={75.5 + i * 19}>
          {c.label}
        </text>
        <text class="t" x="296" y={75.5 + i * 19} text-anchor="end">
          {c.value}
        </text>
      </g>
    ))
  }

  <line class="rule" x1="24" x2="296" y1="150" y2="150"></line>
  <g class="profit">
    <text class="t strong" x="24" y="176">True profit</text>
    <text class="money" x="296" y="178" text-anchor="end">₹370</text>
  </g>
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
  }

  .t {
    font-size: 10px;
    fill: var(--text);
  }

  .strong {
    font-weight: 500;
  }

  .m {
    fill: var(--muted);
  }

  .xs {
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .track {
    fill: #f1f1f1;
  }

  .bar {
    fill: var(--team-ink);
    transform-box: fill-box;
    transform-origin: left center;
    transform: scaleX(0.37);
    animation: cfo-bar 10s cubic-bezier(0.4, 0, 0.2, 1) infinite both;
  }

  .cdot {
    fill: var(--products-ink);
  }

  .rule {
    stroke: var(--hairline);
  }

  .money {
    font-family: var(--font-serif);
    font-size: 20px;
    fill: var(--team-ink);
  }

  .c1 {
    animation: cfo-c1 10s ease infinite both;
  }

  .c2 {
    animation: cfo-c2 10s ease infinite both;
  }

  .c3 {
    animation: cfo-c3 10s ease infinite both;
  }

  .c4 {
    animation: cfo-c4 10s ease infinite both;
  }

  .profit {
    animation: cfo-profit 10s ease infinite both;
  }

  /* revenue 1,000 → 820 → 700 → 610 → 370 */
  @keyframes cfo-bar {
    0%,
    8% {
      transform: scaleX(1);
      fill: var(--text);
    }
    14%,
    20% {
      transform: scaleX(0.82);
    }
    26%,
    32% {
      transform: scaleX(0.7);
    }
    38%,
    44% {
      transform: scaleX(0.61);
      fill: var(--text);
    }
    50%,
    90% {
      transform: scaleX(0.37);
      fill: var(--team-ink);
    }
    100% {
      transform: scaleX(1);
      fill: var(--text);
    }
  }

  @keyframes cfo-c1 {
    0%,
    8% {
      opacity: 0;
      transform: translateY(4px);
    }
    14%,
    92% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes cfo-c2 {
    0%,
    20% {
      opacity: 0;
      transform: translateY(4px);
    }
    26%,
    92% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes cfo-c3 {
    0%,
    32% {
      opacity: 0;
      transform: translateY(4px);
    }
    38%,
    92% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes cfo-c4 {
    0%,
    44% {
      opacity: 0;
      transform: translateY(4px);
    }
    50%,
    92% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes cfo-profit {
    0%,
    52% {
      opacity: 0;
    }
    60%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
