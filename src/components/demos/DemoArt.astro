---
/* Frame for a demo's animated illustration (or its first screenshot if it has no illustration).
   Without JavaScript the animations simply loop; with it, they only play while on screen.
   Reduced motion: the global rule in global.css stops all animation, leaving the final frame. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Rto from './art/Rto.astro';
import Voice from './art/Voice.astro';
import Ops from './art/Ops.astro';
import Competitor from './art/Competitor.astro';
import Creative from './art/Creative.astro';
import Cfo from './art/Cfo.astro';

type Kind = 'rto' | 'voice' | 'ops' | 'competitor' | 'creative' | 'cfo';

/* What each illustration shows, read out by screen readers on detail pages. */
const descriptions: Record<Kind, string> = {
  rto: 'Illustration with sample data: a risk gauge needle settles at 72 out of 100 for a cash-on-delivery order, marked high refusal risk, and the recommended action "Ask for prepayment" appears.',
  voice:
    'Illustration with sample data: a live call waveform while the language label cycles between Hindi, Telugu and Tamil; the call is logged as "Order confirmed" with a summary.',
  ops: 'Illustration with sample data: three alerts slide into an operations feed (stock running low, shipments stuck at a hub, refund requests rising) and the first proposed fix is approved with one tap.',
  competitor:
    "Illustration with sample data: price lines for you and a competitor; the competitor's line dips, a 12% price cut is flagged, and a weekly brief suggests matching price on two products.",
  creative:
    'Illustration with sample data: four ad variations are scored and shuffle into ranked order; the top-scoring variation, 92, is marked as the best bet.',
  cfo: "Illustration with sample data: an order's ₹1,000 revenue bar shrinks as returns, discounts, shipping and ad spend are subtracted, leaving a true profit of ₹370.",
};

interface Props {
  kind?: Kind;
  /** Plain-language description of what the illustration shows (defaults to the built-in one). */
  label?: string;
  /** In cards the meaning is already in the text, so the art is hidden from screen readers. */
  decorative?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  large?: boolean;
}

const { kind, decorative = false, image, imageAlt = '', large = false } = Astro.props;
const arts = { rto: Rto, voice: Voice, ops: Ops, competitor: Competitor, creative: Creative, cfo: Cfo };
const Art = kind ? arts[kind] : undefined;
const label = Astro.props.label ?? (kind ? descriptions[kind] : '');
---

<figure class:list={['demo-art', { large }]}>
  {
    Art ? (
      <div
        class="frame"
        data-demo-art
        role={decorative ? undefined : 'img'}
        aria-label={decorative ? undefined : label}
        aria-hidden={decorative ? 'true' : undefined}
      >
        <Art />
      </div>
    ) : image ? (
      <div class="frame">
        <Image src={image} alt={imageAlt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
    ) : (
      <div class="frame empty" aria-hidden="true" />
    )
  }
  {Art && <figcaption>Illustrative sample data</figcaption>}
</figure>

<script>
  // Play each illustration only while it is on screen (it starts from the beginning when first seen).
  const frames = document.querySelectorAll<HTMLElement>('[data-demo-art]');
  if (frames.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('demo-js');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    frames.forEach((f) => io.observe(f));
  }
</script>

<style>
  .demo-art {
    margin: 0;
  }

  .frame {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    /* animations inside never affect layout outside the frame */
    contain: layout paint style;
    border: 1px solid var(--hairline);
    background: #fcfcfb;
    transition: border-color 250ms var(--ease-out);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .empty {
    background:
      radial-gradient(#dcdcdc 1px, transparent 1.3px) 0 0 / 14px 14px,
      #fcfcfb;
  }

  .large .frame {
    aspect-ratio: 16 / 10;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* With JS: hold every illustration until it scrolls into view */
  :global(html.demo-js [data-demo-art]:not(.is-playing) *) {
    animation-play-state: paused !important;
  }
</style>
