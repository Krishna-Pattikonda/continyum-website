---
/* Small line icon chosen from a link's address: mail, phone, map, or a generic "external" arrow. */
interface Props {
  href: string;
}

const { href } = Astro.props;
const kind = href.startsWith('mailto:')
  ? 'mail'
  : href.startsWith('tel:')
    ? 'phone'
    : href.includes('google.com/maps')
      ? 'map'
      : 'web';
---

<svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    kind === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="1" />
        <path d="m3 7 9 6 9-6" />
      </>
    )
  }
  {
    kind === 'phone' && (
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1" />
    )
  }
  {
    kind === 'map' && (
      <>
        <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    kind === 'web' && (
      <>
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </>
    )
  }
</svg>

<style>
  .link-icon {
    width: 15px;
    height: 15px;
    flex: none;
    fill: none;
    stroke: var(--icon, currentColor);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
