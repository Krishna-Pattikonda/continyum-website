---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import { getContact, getTeam } from '../lib/content';

const contact = await getContact();
const team = (await getTeam()).filter((p) => p.data.links?.length);

const headline = contact.headline ?? 'Contact.';
const title = headline.replace(/[.!]$/, '');
const mark = headline.slice(title.length);

const mailto = (subject?: string) =>
  `mailto:${contact.email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;

// Greetings are drawn by CSS from data-text, so they stay decorative.
const greetings = contact.greetings ?? [];
---

<Base title="Contact" description={contact.intro}>
  <div class="contact">
    <!-- ---------- Intro ---------- -->
    <section class="container intro" aria-labelledby="contact-title">
      <p class="label">Contact</p>
      <h1 id="contact-title" class="big">
        {title}{mark && <span class="mark">{mark}</span>}
      </h1>
      <p class="lede">{contact.intro}</p>

      <p class="email">
        <a href={mailto()}>{contact.email}</a>
      </p>

      {
        contact.topics && (
          <div class="topics">
            <p class="topics-label">Or start with a topic</p>
            <ul>
              {contact.topics.map((t, i) => (
                <li style={`--i: ${i}`}>
                  <a href={mailto(t.subject)}>{t.label}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        contact.channels && (
          <ul class="channels">
            {contact.channels.map((c) => (
              <li>
                <a href={c.url}>
                  <LinkIcon href={c.url} />
                  {c.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- ---------- People + place ---------- -->
    <section class="container connect" aria-label="People and location">
      {
        team.length > 0 && (
          <div class="people reveal">
            <h2 class="section-label">Talk to a founder</h2>
            <ul>
              {team.map(({ data: p }) => (
                <li class="person">
                  {p.photo && (
                    <Image class="face" src={p.photo} alt="" width={56} height={56} densities={[1, 2]} />
                  )}
                  <div>
                    <p class="name">{p.name}</p>
                    <p class="role">{p.role}</p>
                    <ul class="person-links">
                      {p.links!.map((l) => (
                        <li>
                          <a href={l.url}>
                            <LinkIcon href={l.url} />
                            {l.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="place reveal">
        <h2 class="section-label">Find us</h2>

        <div class="map" aria-hidden="true">
          <span class="ring r1"></span>
          <span class="ring r2"></span>
          <span class="ring r3"></span>
          <span class="pin"></span>
          {contact.location?.coordinates && <span class="coords" data-text={contact.location.coordinates}></span>}
        </div>

        {
          contact.address && (
            <address>
              {contact.address.map((line) => (
                <span>{line}</span>
              ))}
            </address>
          )
        }

        <p class="place-meta">
          {contact.location?.timezone && <span>{contact.location.timezone}</span>}
          {
            contact.location?.map_url && (
              <a class="text-link" href={contact.location.map_url}>
                Open in Google Maps
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )
          }
        </p>
      </div>
    </section>

    <!-- ---------- Greetings marquee ---------- -->
    {
      greetings.length > 0 && (
        <div class="marquee" aria-hidden="true">
          <div class="track">
            {[0, 1].map(() =>
              greetings.map((g) => (
                <>
                  <span class="g" data-text={g} />
                  <span class="sep" />
                </>
              )),
            )}
          </div>
        </div>
      )
    }
  </div>
</Base>

<style>
  .contact {
    position: relative;
    isolation: isolate;
  }

  /* Amber glow drifting behind the headline */
  .contact::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -14rem;
    right: -14rem;
    width: 44rem;
    height: 44rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--contact-tint) 0%, transparent 62%);
    opacity: 0.8;
    animation: drift 18s ease-in-out infinite alternate;
  }

  /* ---------- Intro ---------- */

  .intro {
    padding-top: var(--s-8);
  }

  .label {
    animation: rise 700ms var(--ease-out) both;
  }

  .big {
    margin-top: var(--s-3);
    font-size: clamp(3.75rem, 13vw, 9.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    animation: rise 1000ms 80ms var(--ease-out) both;
  }

  /* The full stop slowly cycles through the four brand colours */
  .mark {
    display: inline-block;
    animation: hue 8s linear infinite;
    color: var(--contact-ink);
  }

  @keyframes hue {
    0%,
    100% {
      color: var(--contact-ink);
    }
    25% {
      color: var(--research-ink);
    }
    50% {
      color: var(--products-ink);
    }
    75% {
      color: var(--team-ink);
    }
  }

  .lede {
    margin-top: var(--s-4);
    max-width: 46ch;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    animation: rise 900ms 200ms var(--ease-out) both;
  }

  .email {
    margin-top: var(--s-6);
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 5.5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    animation: rise 900ms 300ms var(--ease-out) both;
  }

  /* Pastel highlighter that sweeps up under the address on hover */
  .email a {
    text-decoration: none;
    background: linear-gradient(var(--contact-tint), var(--contact-tint)) no-repeat left 88% / 100% 0.28em;
    transition: background-size 400ms var(--ease-out);
  }

  .email a:hover {
    background-size: 100% 0.85em;
  }

  /* ---------- Topic chips ---------- */

  .topics {
    margin-top: var(--s-6);
    animation: rise 900ms 400ms var(--ease-out) both;
  }

  .topics-label {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .topics ul {
    list-style: none;
    padding: 0;
    margin-top: var(--s-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .topics li {
    --chip: var(--research-ink);
    --chip-tint: var(--research-tint);
  }

  .topics li:nth-child(4n + 2) {
    --chip: var(--products-ink);
    --chip-tint: var(--products-tint);
  }

  .topics li:nth-child(4n + 3) {
    --chip: var(--team-ink);
    --chip-tint: var(--team-tint);
  }

  .topics li:nth-child(4n + 4) {
    --chip: var(--contact-ink);
    --chip-tint: var(--contact-tint);
  }

  .topics a {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.55rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: #ffffff;
    font-size: var(--text-small);
    text-decoration: none;
    transition:
      border-color 250ms var(--ease-out),
      background-color 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  .topics a::before {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--chip);
  }

  .topics a:hover {
    border-color: var(--chip-tint);
    background: color-mix(in srgb, var(--chip-tint) 30%, white);
    transform: translateY(-2px);
  }

  .channels {
    list-style: none;
    padding: 0;
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
  }

  .channels a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--contact-ink);
  }

  /* ---------- People + place ---------- */

  .connect {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-10);
    padding-block: var(--s-12) var(--s-10);
  }

  @media (min-width: 860px) {
    .connect {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--hairline);
  }

  .people > ul {
    list-style: none;
    padding: 0;
  }

  .person {
    --person: var(--research-ink);
    display: flex;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--hairline);
  }

  .person:nth-child(2) {
    --person: var(--products-ink);
  }

  .person:nth-child(3) {
    --person: var(--team-ink);
  }

  .face {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--person);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .role {
    margin-top: 0.15rem;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--person);
  }

  .person-links {
    list-style: none;
    padding: 0;
    margin-top: var(--s-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-size: var(--text-small);
  }

  .person-links a {
    --icon: var(--person);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    transition: color var(--t);
  }

  .person-links a:hover {
    color: var(--person);
  }

  /* Dotted "map" with a pulsing pin */
  .map {
    position: relative;
    margin-top: var(--s-4);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background:
      radial-gradient(circle at 50% 50%, rgba(253, 230, 138, 0.55), transparent 55%),
      radial-gradient(#bcbcbc 1.1px, transparent 1.5px) 0 0 / 14px 14px,
      #fdfcf8;
  }

  /* fade the dots towards the edges */
  .map::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 50%, #fdfcf8 95%);
    pointer-events: none;
  }

  .pin,
  .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    translate: -50% -50%;
  }

  .pin {
    z-index: 2;
    width: 14px;
    height: 14px;
    background: var(--contact-ink);
    box-shadow:
      0 0 0 3px #ffffff,
      0 0 0 4px rgba(161, 98, 7, 0.35);
  }

  .ring {
    z-index: 1;
    width: 14px;
    height: 14px;
    border: 1px solid var(--contact-ink);
    animation: radar 3.6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }

  .r2 {
    animation-delay: 1.2s;
  }

  .r3 {
    animation-delay: 2.4s;
  }

  @keyframes radar {
    from {
      width: 14px;
      height: 14px;
      opacity: 0.7;
    }
    to {
      width: 220px;
      height: 220px;
      opacity: 0;
    }
  }

  .coords {
    position: absolute;
    z-index: 2;
    top: calc(50% + 18px);
    left: 50%;
    translate: -50% 0;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #8a7a55;
  }

  .coords::before {
    content: attr(data-text);
  }

  address {
    margin-top: var(--s-3);
    font-style: normal;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.35;
  }

  address span {
    display: block;
  }

  .place-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-2);
    font-size: var(--text-small);
    color: var(--muted);
  }

  .place-meta .text-link {
    color: var(--contact-ink);
  }

  /* ---------- Greetings marquee ---------- */

  .marquee {
    overflow: hidden;
    padding-block: var(--s-4) var(--s-8);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .g::before {
    content: attr(data-text);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
    /* solid pale fill — outlined (text-stroke) text this large breaks painting in Chromium */
    color: #dedad0;
  }

  .sep {
    flex: none;
    width: 10px;
    height: 10px;
    margin-inline: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: 50%;
    background: var(--accent);
  }

  /* separators sit at every even position; cycle them through the palette */
  .sep:nth-child(8n + 2) {
    background: var(--research-ink);
  }

  .sep:nth-child(8n + 4) {
    background: var(--products-ink);
  }

  .sep:nth-child(8n + 6) {
    background: var(--team-ink);
  }
</style>
