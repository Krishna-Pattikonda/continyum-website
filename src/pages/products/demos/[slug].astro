---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DemoArt from '../../../components/demos/DemoArt.astro';
import { getDemos, getHome, url, type Demo } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const demos = await getDemos();
  return demos.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: demos[i - 1], next: demos[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Demo;
  prev?: Demo;
  next?: Demo;
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const note = (await getHome()).demos?.note;
---

<Base title={d.name} description={d.tagline} type="article" demos={Boolean(d.illustration)}>
  <article class="container page demo">
    <a class="text-link back-link" href={url('/products/#demos')}>
      <span class="arrow back" aria-hidden="true">←</span>All demos
    </a>

    <p class="label">Demo</p>
    <h1 class="page-title">{d.name}</h1>
    <p class="lede">{d.tagline}</p>
    <p class="status-line"><span class="status" data-status={d.status}>{d.status}</span></p>

    <!-- The problem -->
    <section class="block reveal" aria-labelledby="problem">
      <h2 id="problem" class="section-label">The problem</h2>
      <div class="block-body">
        <p class="problem">{d.problem}</p>
        {
          hasBody && (
            <div class="prose body">
              <Content />
            </div>
          )
        }
      </div>
    </section>

    <!-- How it works -->
    <section class="block reveal" aria-labelledby="how">
      <h2 id="how" class="section-label">How it works</h2>
      <ol class="steps">
        {d.howItWorks.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <!-- The illustration, larger -->
    <section class="block art reveal" aria-label="Illustration">
      <DemoArt kind={d.illustration} image={d.screenshots?.[0]} imageAlt={`${d.name} screenshot`} large />
    </section>

    {
      d.exampleOutput && (
        <section class="block reveal" aria-labelledby="example">
          <h2 id="example" class="section-label">Illustrative example</h2>
          <pre class="example">{d.exampleOutput}</pre>
        </section>
      )
    }

    {
      d.screenshots && d.screenshots.length > (d.illustration ? 0 : 1) && (
        <section class="block reveal" aria-labelledby="screens">
          <h2 id="screens" class="section-label">Screenshots</h2>
          <ul class="shots">
            {d.screenshots.slice(d.illustration ? 0 : 1).map((shot, i) => (
              <li>
                <Image src={shot} alt={`${d.name} screenshot ${i + 1}`} widths={[480, 960]} sizes="(min-width: 860px) 50vw, 100vw" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Status, stack, links -->
    <section class="block reveal" aria-labelledby="details">
      <h2 id="details" class="section-label">Details</h2>
      <dl class="facts">
        <div>
          <dt>Status</dt>
          <dd><span class="status" data-status={d.status}>{d.status}</span></dd>
        </div>
        {
          d.stack && (
            <div>
              <dt>Stack</dt>
              <dd>
                <ul class="stack">
                  {d.stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
      {
        (d.demoUrl || d.videoUrl) && (
          <p class="actions">
            {d.demoUrl && (
              <a class="button" href={d.demoUrl}>
                Try it
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
            {d.videoUrl && (
              <a class="text-link" href={d.videoUrl}>
                Watch video
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
          </p>
        )
      }
    </section>

    <!-- Call to action -->
    <aside class="cta reveal">
      <p class="cta-title">Want this for your business?</p>
      <a class="text-link" href={url('/contact')}>
        Get in touch
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </aside>

    {note && <p class="note">{note}</p>}

    {
      (prev || next) && (
        <nav class="pager" aria-label="More demos">
          {prev ? (
            <a class="pager-link" href={url(`/products/demos/${prev.id}`)}>
              <span class="pager-label">← Previous demo</span>
              <span class="pager-name">{prev.data.name}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="pager-link next" href={url(`/products/demos/${next.id}`)}>
              <span class="pager-label">Next demo →</span>
              <span class="pager-name">{next.data.name}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .lede {
    margin-top: var(--s-3);
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--muted);
    animation: rise 800ms 80ms var(--ease-out) both;
  }

  .back-link {
    display: flex;
    width: fit-content;
  }

  .label {
    display: flex;
    width: fit-content;
    margin-bottom: var(--s-2);
  }

  .status-line {
    margin-top: var(--s-3);
    font-size: var(--text-small);
    font-weight: 500;
  }

  /* ---------- Blocks: label on the left, content on the right (desktop) ---------- */

  .block {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    margin-top: var(--s-10);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 860px) {
    .block {
      grid-template-columns: 12rem 1fr;
      gap: var(--s-6);
    }

    .block.art {
      grid-template-columns: 1fr;
      border-top: 0;
      padding-top: 0;
    }
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .problem {
    max-width: 40rem;
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .body {
    margin-top: var(--s-3);
    color: var(--muted);
  }

  /* Numbered steps, connected by a hairline on wide screens */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
  }

  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      gap: var(--s-4);
    }
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding-top: var(--s-5);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--products-ink);
  }

  .art {
    margin-top: var(--s-8);
  }

  /* keep the large illustration at a readable size, aligned with the content column */
  .art :global(.demo-art) {
    max-width: 48rem;
  }

  @media (min-width: 860px) {
    .art :global(.demo-art) {
      margin-left: calc(12rem + var(--s-6));
    }
  }

  .example {
    margin: 0;
    padding: var(--s-3);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    background: #fcfcfb;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .shots {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--s-3);
  }

  .shots :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
  }

  .facts {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }

  .facts > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
  }

  dt {
    min-width: 4rem;
    font-size: var(--text-small);
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .stack li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-weight: 400;
  }

  .actions {
    grid-column: -2 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-2);
  }

  /* ---------- CTA ---------- */

  .cta {
    margin-top: var(--s-10);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
  }

  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta .text-link {
    font-size: 1.0625rem;
  }

  .note {
    margin-top: var(--s-3);
    max-width: 46rem;
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* ---------- Previous / next ---------- */

  .pager {
    margin-top: var(--s-8);
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
    margin-left: auto;
  }

  .pager-label {
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pager-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    transition: color var(--t);
  }

  .pager-link:hover .pager-name {
    color: var(--products-ink);
  }
</style>
