---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import { formatDate, getResearch, isoDate, url, type Research } from '../../lib/content';

export const getStaticPaths = (async () => {
  const research = await getResearch();
  return research.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Research;
}

const { entry } = Astro.props;
const { title, description, date, status, authors, link } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={description} type="article">
  <article class="container page">
    <a class="text-link back-link" href={url('/research')}>
      <span class="arrow back" aria-hidden="true">←</span>All research
    </a>
    <h1 class="page-title">{title}</h1>
    <EntryMeta date={{ text: formatDate(date), datetime: isoDate(date) }} status={status} />
    {authors && <p class="authors">{authors.join(', ')}</p>}
    {
      link && (
        <p class="external">
          <a class="text-link" href={link}>
            Read the paper
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      )
    }
    <div class="prose body">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* Paper titles run long — smaller and wider than index page titles */
  .page-title {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.2;
    max-width: 30ch;
  }

  .authors {
    margin-top: var(--s-1);
    font-size: var(--text-small);
  }

  .external {
    margin-top: var(--s-3);
  }

  .body {
    margin-top: var(--s-8);
  }
</style>
