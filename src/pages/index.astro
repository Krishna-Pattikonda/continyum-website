---
import Base from '../layouts/Base.astro';
import { getHome, getResearch, href, url } from '../lib/content';

const home = await getHome();

// Split the headline so the chosen highlight phrase can be styled,
// and each word can animate in one after another.
const segments: { text: string; hl: boolean }[] = [];
const at = home.highlight ? home.headline.indexOf(home.highlight) : -1;
if (home.highlight && at >= 0) {
  segments.push({ text: home.headline.slice(0, at), hl: false });
  segments.push({ text: home.highlight, hl: true });
  segments.push({ text: home.headline.slice(at + home.highlight.length), hl: false });
} else {
  segments.push({ text: home.headline, hl: false });
}
let n = 0;
const tokens = segments.map((s) => ({
  hl: s.hl,
  parts: s.text
    .split(/(\s+)/)
    .filter((t) => t !== '')
    .map((t) => (/^\s+$/.test(t) ? { space: true as const } : { word: t, i: n++ })),
}));
const wordCount = n;

// Newest paper that's still in progress, for the "Now researching" ticker.
const now = home.show_now_researching
  ? (await getResearch()).find((r) => r.data.status === 'In progress')
  : undefined;

const description = home.subline || home.headline;
---

<Base description={description}>
  <section class="hero" aria-labelledby="headline" style={`--words: ${wordCount}`}>
    <div class="aurora" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
      <span class="blob b4"></span>
    </div>

    <div class="container hero-inner">
      {home.eyebrow && <p class="eyebrow">{home.eyebrow}</p>}

      <h1 id="headline">
        {
          tokens.map((seg) =>
            seg.hl ? (
              <em class="hl">
                {seg.parts.map((p) =>
                  'space' in p ? ' ' : <span class="w" style={`--i: ${p.i}`}>{p.word}</span>,
                )}
              </em>
            ) : (
              seg.parts.map((p) =>
                'space' in p ? ' ' : <span class="w" style={`--i: ${p.i}`}>{p.word}</span>,
              )
            ),
          )
        }
      </h1>

      {home.subline && <p class="subline">{home.subline}</p>}

      {
        (home.primary_cta || home.secondary_cta) && (
          <div class="actions">
            {home.primary_cta && (
              <a class="button" href={href(home.primary_cta.href)}>
                {home.primary_cta.label}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
            {home.secondary_cta && (
              <a class="text-link" href={href(home.secondary_cta.href)}>
                {home.secondary_cta.label}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      now && (
        <div class="container now-wrap">
          <a class="now" href={url(`/research/${now.id}`)}>
            <span class="pulse" aria-hidden="true" />
            <span class="now-label">Now researching</span>
            <span class="now-title">{now.data.title}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      )
    }
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--s-8) var(--s-12);
  }

  .hero-inner {
    position: relative;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    animation: rise 800ms var(--ease-out) both;
  }

  /* short four-colour rule before the eyebrow */
  .eyebrow::before {
    content: '';
    width: 2rem;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--research-ink) 0 25%,
      var(--products-ink) 25% 50%,
      var(--team-ink) 50% 75%,
      var(--accent) 75% 100%
    );
  }

  h1 {
    margin-top: var(--s-4);
    font-size: clamp(2.75rem, 7vw, 5.75rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  /* each word rises in, one after another */
  .w {
    display: inline-block;
    animation: rise 900ms calc(120ms + var(--i) * 70ms) var(--ease-out) both;
  }

  /* the highlighted phrase: italic, with a colour underline that draws itself */
  .hl {
    font-style: italic;
    padding-right: 0.04em;
    background: linear-gradient(
        90deg,
        var(--research-ink),
        var(--products-ink),
        var(--team-ink),
        var(--accent)
      )
      no-repeat left 94% / 0% 0.07em;
    animation: underline 1100ms calc(250ms + var(--words) * 70ms) var(--ease-out) forwards;
  }

  @keyframes underline {
    to {
      background-size: 100% 0.07em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hl {
      background-size: 100% 0.07em;
    }
  }

  .subline {
    margin-top: var(--s-4);
    max-width: 44ch;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    animation: rise 900ms calc(300ms + var(--words) * 70ms) var(--ease-out) both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
    animation: rise 900ms calc(420ms + var(--words) * 70ms) var(--ease-out) both;
  }

  /* ---------- "Now researching" ticker ---------- */

  .now-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--s-5);
    animation: rise 900ms calc(700ms + var(--words) * 70ms) var(--ease-out) both;
  }

  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    padding: 0.55rem 1rem 0.55rem 0.85rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    font-size: 0.8125rem;
    text-decoration: none;
    transition:
      border-color var(--t),
      background-color var(--t);
  }

  .now:hover {
    border-color: var(--research-tint);
    background: #ffffff;
  }

  .pulse {
    position: relative;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--research-ink);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--research-ink);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .now-label {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--research-ink);
  }

  .now-title {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 46ch;
  }

  .now .arrow {
    flex: none;
    transition: transform 300ms var(--ease-out);
  }

  .now:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 639.98px) {
    .now-label {
      display: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  /* ---------- Aurora: pastel blobs drifting to the right of the text ---------- */

  .aurora {
    position: absolute;
    inset: calc(-1 * var(--header-h)) 0 0 0; /* run up behind the header */
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
    animation: fade-in 1600ms ease-out both;
  }

  .blob {
    position: absolute;
    width: 42vmax;
    height: 42vmax;
    border-radius: 50%;
    opacity: 0.85;
    will-change: transform;
  }

  .b1 {
    top: -12%;
    right: -8%;
    background: radial-gradient(circle, var(--research-tint) 0%, transparent 62%);
    animation: drift-a 22s ease-in-out infinite alternate;
  }

  .b2 {
    top: 18%;
    right: 14%;
    background: radial-gradient(circle, var(--products-tint) 0%, transparent 62%);
    animation: drift-b 26s ease-in-out infinite alternate;
  }

  .b3 {
    bottom: -22%;
    right: -4%;
    background: radial-gradient(circle, var(--team-tint) 0%, transparent 62%);
    animation: drift-c 30s ease-in-out infinite alternate;
  }

  .b4 {
    bottom: -18%;
    right: 30%;
    width: 30vmax;
    height: 30vmax;
    background: radial-gradient(circle, var(--contact-tint) 0%, transparent 62%);
    animation: drift-a 24s -8s ease-in-out infinite alternate-reverse;
  }

  @keyframes drift-a {
    to {
      transform: translate3d(-10%, 12%, 0) scale(1.15);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(12%, -10%, 0) scale(0.9);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate3d(-14%, -8%, 0) scale(1.1);
    }
  }

  @media (max-width: 639.98px) {
    .blob {
      opacity: 0.6;
    }

    .b1 {
      top: auto;
      bottom: -10%;
    }

    .b2 {
      top: auto;
      bottom: 0;
      right: -20%;
    }
  }
</style>
