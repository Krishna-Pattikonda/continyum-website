---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LinkIcon from '../components/LinkIcon.astro';
import { getHome, getTeam } from '../lib/content';
import { people } from '../lib/seo';

const home = await getHome();
const team = await getTeam();
---

<Base title="Team" seoTitle="Team & Founders — Continyum" description={home.seo?.team || home.sections.team.summary} jsonLd={await people()}>
  <div class="container page">
    <h1 class="page-title dot">Team</h1>
    <p class="page-intro">{home.sections.team.summary}</p>

    <ul class="grid">
      {
        team.map(({ data: p }) => (
          <li class="person reveal">
            {p.photo && (
              <div class="avatar">
                <Image src={p.photo} alt={p.name} width={128} height={128} densities={[1, 2]} />
              </div>
            )}

            <h2 class="name">{p.name}</h2>
            <p class="role">{p.role}</p>
            {p.bio && <p class="bio">{p.bio}</p>}

            {p.links && (
              <ul class="links">
                {p.links.map((l) => (
                  <li>
                    <a href={l.url}>
                      <LinkIcon href={l.url} />
                      <span>{l.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  /* Lets the ring's gradient angle animate smoothly */
  @property --angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: var(--s-10) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-10) var(--s-8);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Each person gets the next colour in the palette */
  .person {
    --person: var(--research-ink);
  }

  .person:nth-child(4n + 2) {
    --person: var(--products-ink);
  }

  .person:nth-child(4n + 3) {
    --person: var(--team-ink);
  }

  .person:nth-child(4n + 4) {
    --person: var(--contact-ink);
  }

  /* Photo inside a thin four-colour ring that turns on hover */
  .avatar {
    --angle: 0deg;
    width: 8.5rem;
    height: 8.5rem;
    padding: 3px;
    border-radius: 50%;
    background: conic-gradient(
      from var(--angle),
      var(--research-ink),
      var(--products-ink),
      var(--team-ink),
      var(--accent),
      var(--research-ink)
    );
    margin-bottom: var(--s-4);
  }

  .person:hover .avatar {
    animation: spin 5s linear infinite;
  }

  @keyframes spin {
    to {
      --angle: 360deg;
    }
  }

  .avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--bg);
    object-fit: cover;
    background: var(--bg);
  }

  .name {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .role {
    margin-top: var(--s-1);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--person);
  }

  .bio {
    margin-top: var(--s-2);
    max-width: 44ch;
    color: var(--muted);
  }

  .links {
    list-style: none;
    padding: 0;
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: var(--s-1);
    font-size: var(--text-small);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--text);
    text-decoration: none;
    transition: color var(--t);
  }

  .links a:hover {
    color: var(--person);
  }

  .links a:hover span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .links a {
    --icon: var(--person);
  }
</style>
